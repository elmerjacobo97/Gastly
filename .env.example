NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Tu bot username sin @ (ej: GastlyFinancesBot). Lo ves en BotFather o en t.me/tu_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=gastly_finance_bot

# Local Supabase Docker service role key (get from: supabase status or Dashboard > Project Settings > Api Keys)
SUPABASE_SERVICE_ROLE_KEY=

# Random secret for signing calendar feed tokens (change in production)
CALENDAR_SECRET=